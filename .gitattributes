* text=auto eol=lf
# Large binaries: store in Git LFS (run `git lfs install` once per machine).
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
packages/web/assets/imagery/*.png filter=lfs diff=lfs merge=lfs -text
# Generated files: collapse in diffs
packages/**/generated.ts linguist-generated=true
packages/**/*.generated.ts linguist-generated=true
packages/web/css/ism.css linguist-generated=true
packages/web/css/rtl.css linguist-generated=true
packages/web/css/tokens.css linguist-generated=true
specs/*.json linguist-generated=true
components/*/spec.json linguist-generated=true
