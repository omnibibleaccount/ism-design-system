      }
    },
    "easing": {
      "ease-standard": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ],
        "$description": "Default for state changes.",
        "$extensions": {
          "ism.css": "ease"
        }
      },
      "ease-drawer": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$description": "Drawers and sheets: fast start, soft landing.",
        "$extensions": {
          "ism.css": "cubic-bezier(0.2, 0.8, 0.2, 1)"
        }
      },
      "ease-rise": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.7,
          0.2,
          1
        ],
        "$description": "Entrance rise.",
        "$extensions": {
          "ism.css": "cubic-bezier(0.2, 0.7, 0.2, 1)"
        }
      },
      "ease-linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "Spinners and indeterminate progress only.",
        "$extensions": {
          "ism.css": "linear"
        }
      }
    }
  },
